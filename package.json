{
  "name": "dt-fms",
  "private": true,
  "version": "1.0.1",
  "description": "Comprehensive petrol station operational management platform featuring live tank and pump monitoring, multi-role POS, 3-way shift reconciliation, eTIMS tax compliance, and audit tracking.",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "predev": "node scripts/free-dev-ports.js",
    "dev": "tsx server.ts",
    "desktop:dev": "electron electron/main.mjs",
    "desktop:build": "npm run db:validate && npm run build",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "preview": "vite preview",
    "clean": "if exist dist rmdir /s /q dist",
    "lint": "tsc --noEmit",
    "db:validate": "set ELECTRON_RUN_AS_NODE=1&& electron node_modules/tsx/dist/cli.mjs scripts/db-validate.ts",
    "postinstall": "electron-builder install-app-deps",
    "desktop:dist": "node scripts/clean-desktop-output.mjs && npm run desktop:build && electron-builder --win nsis"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.34.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.86.0",
    "react-hot-toast": "^2.6.0",
    "vite": "^6.4.3",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.deities.dtfms",
    "productName": "DT-FMS2.0",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "node_modules/better-sqlite3/**/*",
      "build/icon.ico"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/uninstaller-dialog.nsh"
    }
  }
}
